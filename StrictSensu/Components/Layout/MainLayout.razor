<style>

    /* Aumenta o tamanho da barra lateral */
    .mud-drawer {
        width: 320px !important;
    }

    /* Garante que o conteúdo principal da página se ajuste ao novo tamanho do menu */
    .mud-layout .mud-main-content {
        margin-left: 320px !important; /* Deve ser o mesmo valor de largura definido acima */
    }
