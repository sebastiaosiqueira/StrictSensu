@page "/oferecimento/oferecimento/"
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">Configuração de Oferecimento de Matrícula</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudForm @ref="form" @bind-IsValid="@isValid">
            <MudGrid VerticalAlignment="VerticalAlignment.Center">

                <MudItem XS="12" SM="2">
                    <MudDatePicker Label="Início da Matrícula"
                                   @bind-Date="inicioMatricula"
                                   Required="true"
                                   RequiredError="Obrigatório." />
                </MudItem>

                <MudItem XS="12" SM="2">
                    <MudDatePicker Label="Final da Matrícula"
                                   @bind-Date="finalMatricula"
                                   Required="true"
                                   RequiredError="Obrigatório." />
                </MudItem>

                <MudItem XS="12" SM="3">
                    <MudSelect T="string"
                               Label="Disciplinas"
                               MultiSelection="true"
                               @bind-SelectedValues="disciplinasSelecionadas"
                               Required="true"
                               RequiredError="Selecione ao menos uma disciplina.">
                        @foreach (var disc in listaDisciplinasBanco)
                        {
                            <MudSelectItem Value="@disc">@disc</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem XS="12" SM="3">
                    <MudSelect T="string"
                               Label="Turmas / Cursos"
                               MultiSelection="true"
                               @bind-SelectedValues="cursosSelecionados"
                               Required="true"
                               RequiredError="Selecione ao menos um curso.">
                        @foreach (var curso in listaCursosDisponiveis)
                        {
                            var cursoFormatado = $"2026A - 1 - {curso}";
                            <MudSelectItem Value="@cursoFormatado">@cursoFormatado</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem XS="12" SM="2" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AdicionarEmLoteAGrid"
                               FullWidth="true">
                        Adicionar
                    </MudButton>
                </MudItem>

            </MudGrid>
        </MudForm>
    </MudPaper>

    <MudDataGrid Items="@listaGridPrincipal" T="GridOferecimentoModel" Hover="true" Striped="true" Elevation="1">
        <Columns>
            <PropertyColumn Property="x => x.DisciplinaSelecionada" Title="Disciplina" />
            <PropertyColumn Property="x => x.CursoSelecionado" Title="Curso / Turma" />
            <PropertyColumn Property="x => x.InicioMatricula" Title="Início Matrícula" Format="dd/MM/yyyy" />
            <PropertyColumn Property="x => x.FinalMatricula" Title="Final Matrícula" Format="dd/MM/yyyy" />
            <PropertyColumn Property="x => x.InicioCurso" Title="Início do Curso" Format="dd/MM/yyyy" />
            <PropertyColumn Property="x => x.FinalCurso" Title="Final do Curso" Format="dd/MM/yyyy" />

            <TemplateColumn Title="Ações" CellClass="d-flex justify-end">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Title="Excluir Registro"
                                   OnClick="@(() => ExcluirItem(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</MudContainer>

@code {
    private MudForm form;
    private bool isValid;

    private DateTime? inicioMatricula;
    private DateTime? finalMatricula;

    // Coleções para armazenar as seleções múltiplas do topo
    private IEnumerable<string> disciplinasSelecionadas = new HashSet<string>();
    private IEnumerable<string> cursosSelecionados = new HashSet<string>();

    private List<string> listaCursosDisponiveis = new() { "DOUTORADO EM BIOTECNOLOGIA", "DOUTORADO EM CIÊNCIAS AMBIENTAIS E SUSTENTABILIDADE AGROPECUÁRIA", "DOUTORADO EM DESENVOLVIMENTO LOCAL", "DOUTORADO EM EDUCAÇÃO" };
    private List<string> listaDisciplinasBanco = new() { "Fundamentos e Aplicações do Zebrafish em Pesquisa Científica", "ADMINISTRACAO LOCAL", "APRENDIZAGEM ESCOLAR E COGNIÇÃO", "A DIMENSÃO HUMANA E A SOLIDARIEDADE ATIVA NO TERRITÓRIO", "A DESCENTRALIZAÇÃO DO SISTEMA ESCOLAR", "AGROCOMBUSTIVEIS E SUSTENTABILIDADE RURAL" };

    private List<GridOferecimentoModel> listaGridPrincipal = new();

    private async Task AdicionarEmLoteAGrid()
    {
        await form.Validate();

        if (isValid)
        {
            // Faz o cruzamento (PRODUTO CARTESIANO) de todas as disciplinas com todos os cursos selecionados
            foreach (var disc in disciplinasSelecionadas)
            {
                foreach (var curso in cursosSelecionados)
                {
                    // Evita duplicidade exata na tabela se o usuário clicar em adicionar duas vezes
                    if (!listaGridPrincipal.Any(x => x.DisciplinaSelecionada == disc && x.CursoSelecionado == curso))
                    {
                        var novoOferecimento = new GridOferecimentoModel
                        {
                            DisciplinaSelecionada = disc,
                            CursoSelecionado = curso, // Guarda o nome do curso formatado direto na linha
                            InicioMatricula = inicioMatricula,
                            FinalMatricula = finalMatricula,
                            InicioCurso = DateTime.Today.AddMonths(2),
                            FinalCurso = DateTime.Today.AddMonths(7)
                        };

                        listaGridPrincipal.Add(novoOferecimento);
                    }
                }
            }

            // Limpa os campos de seleção do formulário após adicionar
            disciplinasSelecionadas = new HashSet<string>();
            cursosSelecionados = new HashSet<string>();

            form.ResetValidation();
            StateHasChanged();
        }
    }

    private void ExcluirItem(GridOferecimentoModel item)
    {
        if (item != null && listaGridPrincipal.Contains(item))
        {
            listaGridPrincipal.Remove(item);
            StateHasChanged();
        }
    }

    // O modelo agora representa uma linha única com o vínculo direto de 1 Disciplina para 1 Curso
    public class GridOferecimentoModel
    {
        public string DisciplinaSelecionada { get; set; }
        public string CursoSelecionado { get; set; }
        public DateTime? InicioMatricula { get; set; }
        public DateTime? FinalMatricula { get; set; }
        public DateTime InicioCurso { get; set; }
        public DateTime FinalCurso { get; set; }
    }
}