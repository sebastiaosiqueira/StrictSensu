@page "/oferecimento/lotacao"
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">Atribuição de Múltiplos Professores por Disciplina Única</MudText>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
        Cada linha abaixo representa uma disciplina única gerada nos oferecimentos. Defina os professores responsáveis (um ou mais) que atuarão nela.
    </MudAlert>

    <MudDataGrid Items="@listaDisciplinasOferecidas" T="DisciplinaOferecimentoModel" Hover="true" Striped="true" Elevation="1">
        <Columns>
            <HierarchyColumn T="DisciplinaOferecimentoModel" />

            <PropertyColumn Property="x => x.DisciplinaNome" Title="Disciplina" />

            <TemplateColumn Title="Cursos Vinculados neste Oferecimento">
                <CellTemplate>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var curso in context.Item.CursosVinculados)
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Text">@curso</MudChip>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Status de Atribuição">
                <CellTemplate>
                    @if (context.Item.ProfessoresNomes != null && context.Item.ProfessoresNomes.Any())
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                            @context.Item.ProfessoresNomes.Count() Professor(es) Alocado(s)
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">
                            Sem Professor
                        </MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>

        <ChildRowContent>
            <MudCard Elevation="0" Class="pa-4" Style="background-color: #fafafa; border-left: 4px solid #ff9800;">
                <MudText Typo="Typo.subtitle2" Class="mb-3" Color="Color.Warning">
                    <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Size="Size.Small" Class="mr-1" />
                    Designar Equipe Docente para: <b>@context.Item.DisciplinaNome</b>
                </MudText>

                <MudGrid Spacing="2">
                    <MudItem XS="12" SM="8" MD="6">
                        <MudSelect T="string"
                                   Label="Professores Responsáveis"
                                   MultiSelection="true"
                                   SelectedValues="@context.Item.ProfessoresNomes"
                                   SelectedValuesChanged="@((IEnumerable<string> novosProfs) => OnProfessoresChanged(context.Item, novosProfs))"
                                   SelectAll="true"
                                   SelectAllText="Selecionar Todos"
                                   Variant="Variant.Outlined"
                                   AdornmentIcon="@Icons.Material.Filled.People"
                                   AdornmentColor="Color.Primary">
                            @foreach (var prof in listaProfessoresBanco)
                            {
                                <MudSelectItem Value="@prof">@prof</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudCard>
        </ChildRowContent>
    </MudDataGrid>

    <div class="d-flex justify-end mt-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   Size="Size.Large"
                   OnClick="SalvarAtribuicoes">
            Salvar Atribuições
        </MudButton>
    </div>
</MudContainer>

@code {
    private List<string> listaProfessoresBanco = new()
    {
        "Prof. Dr. Alan Turing",
        "Profª. Ma. Grace Hopper",
        "Prof. Esp. Linus Torvalds",
        "Profª. Dra. Ada Lovelace",
        "Prof. Dr. Edsger Dijkstra"
    };

    // Nova modelagem agrupada por disciplina única
    private List<DisciplinaOferecimentoModel> listaDisciplinasOferecidas = new();

    protected override void OnInitialized()
    {
        // Simulando dados que vieram agrupados da tela anterior (Agrupados por Disciplina)
        listaDisciplinasOferecidas = new List<DisciplinaOferecimentoModel>
        {
            new DisciplinaOferecimentoModel
            {
                DisciplinaNome = "Fundamentos e Aplicações do Zebrafish em Pesquisa Científica",
                CursosVinculados = new List<string> { "2026A - 1 - Doutorado em Psicologia", "2026A - 1 - Doutorado em Biotecnologia" },
                ProfessoresNomes = new HashSet<string>() // Começa vazio
            },
            new DisciplinaOferecimentoModel
            {
                DisciplinaNome = "A DIMENSÃO HUMANA E A SOLIDARIEDADE ATIVA NO TERRITÓRIO",
                CursosVinculados = new List<string> { "2026A - 1 - Doutorado em Psicologia" },
                ProfessoresNomes = new HashSet<string> { "Profª. Dra. Ada Lovelace", "Prof. Dr. Alan Turing" } // Já inicia com dois professores
            },
            new DisciplinaOferecimentoModel
            {
                DisciplinaNome = "ADMINISTRACAO LOCAL",
                CursosVinculados = new List<string> { "2026A - 1 - Doutorado em Ciencias Ambientas" },
                ProfessoresNomes = new HashSet<string>()
            }
        };
    }

    // Captura a troca da lista de professores selecionados
    private void OnProfessoresChanged(DisciplinaOferecimentoModel item, IEnumerable<string> novosProfessores)
    {
        item.ProfessoresNomes = novosProfessores ?? new HashSet<string>();
        StateHasChanged(); // Atualiza a Grid instantaneamente
    }

    private void SalvarAtribuicoes()
    {
        // Aqui os dados já vão prontos: 1 Disciplina mapeada para N Professores de uma vez só!
        Console.WriteLine("Lotação em lote por disciplina salva com sucesso!");
    }

    // Estrutura de Modelo focada na Disciplina Única e suportando N Professores
    public class DisciplinaOferecimentoModel
    {
        public string DisciplinaNome { get; set; }

        // Mantém o rastreio de quais turmas herdarão essa configuração
        public List<string> CursosVinculados { get; set; } = new List<string>();

        // Modificado de string para coleção para aceitar múltiplos professores
        public IEnumerable<string> ProfessoresNomes { get; set; } = new HashSet<string>();
    }
}